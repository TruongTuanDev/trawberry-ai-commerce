# Production environment template.
# Copy to infra/.env.production on the VPS and replace every placeholder before first deploy.
# This file must never contain real secrets.

# Runtime
APP_ENV=production
NODE_ENV=production
PUBLIC_SITE_URL=https://yourdomain.ru
FRONTEND_URL=https://yourdomain.ru
BACKEND_PUBLIC_URL=https://api.yourdomain.ru
NEXT_PUBLIC_SITE_URL=https://yourdomain.ru
NEXT_PUBLIC_API_URL=https://api.yourdomain.ru
SITE_URL=https://yourdomain.ru
API_URL=https://api.yourdomain.ru
NGINX_HTTP_PORT=80

# Security
JWT_SECRET=change-me-jwt-secret
JWT_ACCESS_SECRET=change-me-jwt-access-secret
JWT_REFRESH_SECRET=change-me-jwt-refresh-secret
INTERNAL_API_TOKEN=change-me-internal-token
AI_SERVICE_INTERNAL_TOKEN=change-me-internal-token
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_MAX_AGE_SECONDS=86400
CORS_ORIGIN=https://yourdomain.ru
CORS_ALLOWED_ORIGINS=https://yourdomain.ru
WB_CREDENTIAL_ENCRYPTION_KEY=change-me-wb-encryption-key
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Database
POSTGRES_DB=strawberry
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password
DATABASE_URL=postgresql://postgres:change-me-postgres-password@postgres:5432/strawberry?schema=public

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Storage
STORAGE_DRIVER=s3
FILE_STORAGE_DRIVER=s3
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://storage.yourdomain.ru
S3_PUBLIC_BASE_URL=https://storage.yourdomain.ru
S3_REGION=us-east-1
S3_BUCKET=strawberry-ai-assets
S3_ACCESS_KEY=change-me-minio-access-key
S3_SECRET_KEY=change-me-minio-secret-key
S3_ACCESS_KEY_ID=change-me-minio-access-key
S3_SECRET_ACCESS_KEY=change-me-minio-secret-key

# MinIO
MINIO_ROOT_USER=change-me-minio-access-key
MINIO_ROOT_PASSWORD=change-me-minio-secret-key
MINIO_BUCKET=strawberry-ai-assets
AI_TRY_ON_BUCKET=ai-try-on

# AI
AI_WORKER_MODE=ai-service
AI_IMAGE_PROVIDER=mock
AI_TRY_ON_ENABLED=false
AI_TRY_ON_PROVIDER=demo
OPENAI_API_KEY=
RUN_OPENAI_SMOKE=false
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_OUTPUT_FORMAT=jpeg
OPENAI_IMAGE_TIMEOUT_SECONDS=120
OPENAI_IMAGE_MAX_RETRIES=1
MAX_INPUT_IMAGE_SIZE_MB=15
NEST_CALLBACK_AUTH_TOKEN=
FRONTEND_INTERNAL_BASE_URL=http://frontend-next:3000

AI_SERVICE_TIMEOUT_MS=45000
AI_SERVICE_RETRY_ATTEMPTS=3
AI_SERVICE_RETRY_DELAY_MS=1000

# Production image overrides
# These can be replaced by infra/.env.deploy during GitHub Actions CD.
BACKEND_IMAGE=ghcr.io/owner/repo/backend-nest:latest
FRONTEND_IMAGE=ghcr.io/owner/repo/frontend-next:latest
AI_SERVICE_IMAGE=ghcr.io/owner/repo/ai-service:latest
NGINX_IMAGE=ghcr.io/owner/repo/nginx:latest

# Mock-safe external provider defaults
WB_SYNC_MODE=mock
WB_API_BASE_URL=https://content-api.wildberries.ru
WB_SYNC_TIMEOUT_MS=30000
WB_SYNC_PAGE_LIMIT=100
WB_SYNC_MAX_PAGES=20
DELIVERY_PROVIDER_MODE=mock
DELIVERY_DEFAULT_PROVIDER=yandex
DELIVERY_SAME_CITY_PREFERRED_PROVIDER=yandex
DELIVERY_INTER_CITY_PREFERRED_PROVIDER=cdek
DELIVERY_FALLBACK_PROVIDER=cdek
CDEK_DELIVERY_ENABLED=false
CDEK_API_BASE_URL=
CDEK_ACCOUNT=
CDEK_SECURE_PASSWORD=
CDEK_TIMEOUT_MS=30000
CDEK_DEFAULT_CURRENCY=RUB
CDEK_DEFAULT_TARIFF_CODE=
YANDEX_DELIVERY_ENABLED=false
YANDEX_DELIVERY_BASE_URL=https://b2b.taxi.yandex.net
YANDEX_DELIVERY_TOKEN=
YANDEX_DELIVERY_CLIENT_ID=
YANDEX_DELIVERY_TIMEOUT_MS=30000

# Controlled recommendation tuning stays dark in production by default.
RECOMMENDATION_TUNING_WORKFLOW_ENABLED=false
RECOMMENDATION_TUNING_PRESETS_ENABLED=false
RECOMMENDATION_TUNING_ACTIVE_PRESET_ENABLED=false
ADS_INVALID_CLICK_PROTECTION_ENABLED=true
ADS_SELF_CLICK_BLOCK_ENABLED=true
ADS_MANUAL_TOP_UP_ENABLED=true
ADS_DEMO_FUNDING_ENABLED=false
ADS_TOP_UP_TRANSFER_RECIPIENT=
ADS_TOP_UP_TRANSFER_BANK=
ADS_TOP_UP_TRANSFER_ACCOUNT=
ADS_TOP_UP_TRANSFER_INSTRUCTIONS=
ADS_RAPID_REPEAT_CLICK_WINDOW_SECONDS=30
ADS_IP_REPEAT_CLICK_WINDOW_SECONDS=10
ADS_CLICK_HASH_SALT=change-me-ads-click-hash-salt
