FRONTEND_PORT=3000
BACKEND_PORT=3001
AI_SERVICE_PORT=8000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=strawberry
POSTGRES_PORT=5433

REDIS_PORT=6379

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=strawberry-ai-assets
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

JWT_ACCESS_SECRET=dev-access-secret
JWT_REFRESH_SECRET=dev-refresh-secret
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_MAX_AGE_SECONDS=86400

AI_SERVICE_INTERNAL_TOKEN=dev-internal-token
AI_SERVICE_BASE_URL=http://ai-service:8000
AI_SERVICE_BASE_URL_HOST=http://127.0.0.1:8000
AI_WORKER_MODE=ai-service
BACKEND_INTERNAL_BASE_URL=http://backend-nest:3001
BACKEND_PUBLIC_BASE_URL=http://127.0.0.1:3001
AI_IMAGE_PROVIDER=mock
RUN_OPENAI_SMOKE=false
OPENAI_API_KEY=
# Opt-in real OpenAI verification:
# AI_IMAGE_PROVIDER=openai
# RUN_OPENAI_SMOKE=true
# OPENAI_API_KEY=<local-only-secret>
DELIVERY_PROVIDER_MODE=mock
WB_SYNC_MODE=mock
WB_API_BASE_URL=https://content-api.wildberries.ru
WB_SYNC_TIMEOUT_MS=30000
WB_SYNC_PAGE_LIMIT=100
WB_SYNC_MAX_PAGES=20
WB_CREDENTIAL_ENCRYPTION_KEY=change-me-local-wb-credential-key
# Set WB_SYNC_MODE=real to call Wildberries for seller credential verify/sync.
# Seller runtime credentials are entered in the UI and stored encrypted per shop.
# WB_REAL_API_KEY is a local smoke helper only. Do not use it as runtime sync credential storage.
# WB_REAL_SHOP_ID can be used by npm run debug:wb-credential after a seller already saved a key in the UI.
# WB_REAL_TEST_ARTICLE=
DELIVERY_DEFAULT_PROVIDER=yandex
DELIVERY_SAME_CITY_PREFERRED_PROVIDER=yandex
DELIVERY_INTER_CITY_PREFERRED_PROVIDER=cdek
DELIVERY_FALLBACK_PROVIDER=cdek
CDEK_DELIVERY_ENABLED=false
CDEK_API_BASE_URL=
CDEK_ACCOUNT=
CDEK_SECURE_PASSWORD=
CDEK_TIMEOUT_MS=30000
CDEK_DEFAULT_CURRENCY=RUB
CDEK_DEFAULT_TARIFF_CODE=
YANDEX_DELIVERY_ENABLED=false
YANDEX_DELIVERY_BASE_URL=https://b2b.taxi.yandex.net
YANDEX_DELIVERY_TOKEN=
YANDEX_DELIVERY_CLIENT_ID=
YANDEX_DELIVERY_TIMEOUT_MS=30000

STORAGE_DRIVER=mock
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=strawberry-ai-assets
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_BASE_URL=http://localhost:9000/strawberry-ai-assets

NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
