FRONTEND_PORT=3000
BACKEND_PORT=3001
AI_SERVICE_PORT=8000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=strawberry
POSTGRES_PORT=5433

REDIS_PORT=6379

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=strawberry-ai-assets
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

JWT_ACCESS_SECRET=dev-access-secret
JWT_REFRESH_SECRET=dev-refresh-secret
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_MAX_AGE_SECONDS=86400

AI_SERVICE_INTERNAL_TOKEN=dev-internal-token
AI_SERVICE_BASE_URL=http://ai-service:8000
AI_IMAGE_PROVIDER=mock
RUN_OPENAI_SMOKE=false
OPENAI_API_KEY=

STORAGE_DRIVER=s3
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=strawberry-ai-assets
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_BASE_URL=http://localhost:9000/strawberry-ai-assets

NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
