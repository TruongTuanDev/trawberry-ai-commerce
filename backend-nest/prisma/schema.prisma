generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email                   String                 @unique @db.VarChar(255)
  passwordHash            String                 @map("password_hash") @db.VarChar(255)
  fullName                String?                @map("full_name") @db.VarChar(255)
  phone                   String?                @unique @db.VarChar(255)
  preferredLocale         String?                @map("preferred_locale") @db.VarChar(10)
  role                    String                 @db.VarChar(50)
  status                  String                 @default("ACTIVE") @db.VarChar(50)
  createdAt               DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  sellerProfile           SellerProfile?
  reviewedSellerDocuments SellerDocument[]       @relation("SellerDocumentReviewer")
  adminAuditActions       AdminAuditLog[]        @relation("AdminAuditActor")
  adminAuditTargets       AdminAuditLog[]        @relation("AdminAuditTarget")
  assignedAdminQueueTasks  AdminQueueTask[]       @relation("AdminQueueTaskAssignee")
  adminQueueTaskEvents     AdminQueueTaskEvent[]  @relation("AdminQueueTaskEventActor")
  aiGenerationTasks       AiGenerationTask[]
  aiUsageLogs             AiUsageLog[]
  aiTryOnTasks            AiTryOnTask[]
  aiTryOnUsageLogs        AiTryOnUsageLog[]
  customerOrders          Order[]                @relation("CustomerOrders")
  marketplaceCheckouts    MarketplaceCheckout[]  @relation("CustomerMarketplaceCheckouts")
  supportCases            SupportCase[]          @relation("CustomerSupportCases")
  supportCaseMessages     SupportCaseMessage[]   @relation("SupportCaseMessageSender")
  supportCaseEvents       SupportCaseEvent[]     @relation("SupportCaseEventActor")
  paymentReviewLogs       PaymentReviewLog[]     @relation("PaymentReviewerLogs")
  productImportSessions   ProductImportSession[]
  wbSyncRuns              WbSyncRun[]            @relation("WbSyncRunSeller")
  customerAddresses       CustomerAddress[]
  createdShopCommissionSettings ShopCommissionSetting[] @relation("ShopCommissionSettingAdmin")
  sellerFeeLedgerEntries  SellerFeeLedgerEntry[] @relation("SellerFeeLedgerSeller")
  sellerMonthlyInvoices   SellerMonthlyInvoice[] @relation("SellerMonthlyInvoiceSeller")
  customerReturnRefundCases ReturnRefundCase[]   @relation("CustomerReturnRefundCases")
  sellerReturnRefundCases   ReturnRefundCase[]   @relation("SellerReturnRefundCases")
  returnRefundMessages      ReturnRefundMessage[] @relation("ReturnRefundMessageAuthor")
  returnRefundEvidence      ReturnRefundEvidence[] @relation("ReturnRefundEvidenceUploader")
  sentRefundTransfers       RefundManualTransfer[] @relation("RefundTransferSeller")
  receivedRefundTransfers   RefundManualTransfer[] @relation("RefundTransferCustomer")
  notifications             Notification[]         @relation("RecipientNotifications")
  customerProductReviews    ProductReview[]        @relation("CustomerProductReviews")
  sellerProductReviews      ProductReview[]        @relation("SellerProductReviews")
  customerMessageThreads    ShopMessageThread[]    @relation("CustomerMessageThreads")
  sellerMessageThreads      ShopMessageThread[]    @relation("SellerMessageThreads")
  customerSentShopMessages  ShopMessage[]          @relation("CustomerShopMessages")
  sellerSentShopMessages    ShopMessage[]          @relation("SellerShopMessages")
  adminSentShopMessages     ShopMessage[]          @relation("AdminShopMessages")

  @@map("users")
}

model CustomerAddress {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  customerId    String   @map("customer_id") @db.Uuid
  fullName      String   @map("full_name") @db.VarChar(255)
  phone         String   @db.VarChar(50)
  country       String   @default("Russia") @db.VarChar(100)
  countryCode   String   @default("RU") @map("country_code") @db.VarChar(10)
  city          String   @db.VarChar(255)
  region        String   @db.VarChar(255)
  federalSubject String? @map("federal_subject") @db.VarChar(255)
  cityType      String?  @map("city_type") @db.VarChar(100)
  district      String?  @db.VarChar(255)
  settlement    String?  @db.VarChar(255)
  street        String
  streetType    String?  @map("street_type") @db.VarChar(100)
  building      String   @default("") @db.VarChar(255)
  buildingBlock String?  @map("building_block") @db.VarChar(255)
  entrance      String?  @db.VarChar(255)
  noEntrance    Boolean  @default(false) @map("no_entrance")
  intercom      String?  @db.VarChar(255)
  floor         String?  @db.VarChar(255)
  noFloor       Boolean  @default(false) @map("no_floor")
  apartment     String?  @db.VarChar(255)
  noApartment   Boolean  @default(false) @map("no_apartment")
  postalCode    String?  @map("postal_code") @db.VarChar(50)
  comment       String?  @db.VarChar(1000)
  latitude      Decimal? @db.Decimal(10, 7)
  longitude     Decimal? @db.Decimal(10, 7)
  geoPrecision  String   @default("UNKNOWN") @map("geo_precision") @db.VarChar(50)
  geoProvider   String   @default("MANUAL") @map("geo_provider") @db.VarChar(50)
  geoProviderUri String? @map("geo_provider_uri") @db.VarChar(1000)
  geoRawPayload Json?    @map("geo_raw_payload")
  addressFullName String @default("") @map("address_full_name")
  addressShortName String @default("") @map("address_short_name")
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer      User     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@index([customerId, isDefault])
  @@map("customer_addresses")
}

model SellerProfile {
  id              String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId          String           @unique @map("user_id") @db.Uuid
  approvalStatus  String           @default("PENDING") @map("approval_status") @db.VarChar(50)
  reviewedAt      DateTime?        @map("reviewed_at") @db.Timestamptz(6)
  reviewNote      String?          @map("review_note")
  approvedAt      DateTime?        @map("approved_at") @db.Timestamptz(6)
  rejectedAt      DateTime?        @map("rejected_at") @db.Timestamptz(6)
  rejectionReason String?          @map("rejection_reason") @db.VarChar(500)
  legalType       String?          @map("legal_type") @db.VarChar(50)
  legalName       String?          @map("legal_name") @db.VarChar(255)
  inn             String?          @db.VarChar(20)
  ogrn            String?          @db.VarChar(20)
  kpp             String?          @db.VarChar(20)
  legalAddress    String?          @map("legal_address")
  contactName     String?          @map("contact_name") @db.VarChar(255)
  contactPhone    String?          @map("contact_phone") @db.VarChar(50)
  contactEmail    String?          @map("contact_email") @db.VarChar(255)
  bankName        String?          @map("bank_name") @db.VarChar(255)
  bankAccount     String?          @map("bank_account") @db.VarChar(255)
  bik             String?          @db.VarChar(50)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  currentShopId   String?          @map("current_shop_id") @db.Uuid
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  shops           Shop[]           @relation("SellerProfileShops")
  currentShop     Shop?            @relation("CurrentShopSelection", fields: [currentShopId], references: [id])
  documents       SellerDocument[]

  @@map("seller_profiles")
}

model SellerDocument {
  id               String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  documentType     String        @map("document_type") @db.VarChar(50)
  url              String        @db.VarChar(1000)
  storageKey       String?       @map("storage_key") @db.VarChar(1024)
  originalName     String?       @map("original_name") @db.VarChar(255)
  mimeType         String?       @map("mime_type") @db.VarChar(100)
  size             Int?
  status           String        @default("PENDING") @db.VarChar(50)
  rejectionReason  String?       @map("rejection_reason") @db.VarChar(500)
  uploadedAt       DateTime      @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  reviewedAt       DateTime?     @map("reviewed_at") @db.Timestamptz(6)
  reviewedByUserId String?       @map("reviewed_by_user_id") @db.Uuid
  sellerProfile    SellerProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  reviewedBy       User?         @relation("SellerDocumentReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([userId, uploadedAt])
  @@index([status, uploadedAt])
  @@map("seller_documents")
}

model AdminAuditLog {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  actorUserId  String   @map("actor_user_id") @db.Uuid
  targetUserId String?  @map("target_user_id") @db.Uuid
  action       String   @db.VarChar(100)
  entityType   String   @map("entity_type") @db.VarChar(100)
  entityId     String?  @map("entity_id") @db.VarChar(100)
  oldValueJson Json?    @map("old_value_json")
  newValueJson Json?    @map("new_value_json")
  reason       String?  @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor        User     @relation("AdminAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  target       User?    @relation("AdminAuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([targetUserId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("admin_audit_logs")
}

model AdminQueueTask {
  id               String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  entityType       String                @map("entity_type") @db.VarChar(50)
  entityId         String                @map("entity_id") @db.VarChar(100)
  shopId           String?               @map("shop_id") @db.Uuid
  sellerId         String?               @map("seller_id") @db.Uuid
  assignedToUserId String?               @map("assigned_to_user_id") @db.Uuid
  status           String                @default("OPEN") @db.VarChar(50)
  priority         String                @default("NORMAL") @db.VarChar(50)
  slaStatus        String                @default("OK") @map("sla_status") @db.VarChar(50)
  title            String                @db.VarChar(500)
  summary          String?
  lastNote         String?               @map("last_note")
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  assignedAt       DateTime?             @map("assigned_at") @db.Timestamptz(6)
  resolvedAt       DateTime?             @map("resolved_at") @db.Timestamptz(6)
  escalatedAt      DateTime?             @map("escalated_at") @db.Timestamptz(6)
  assignedTo       User?                 @relation("AdminQueueTaskAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  events           AdminQueueTaskEvent[]

  @@unique([entityType, entityId])
  @@index([status, updatedAt])
  @@index([assignedToUserId, status])
  @@index([entityType, entityId])
  @@map("admin_queue_tasks")
}

model AdminQueueTaskEvent {
  id              String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  taskId          String         @map("task_id") @db.Uuid
  actorUserId     String         @map("actor_user_id") @db.Uuid
  action          String         @db.VarChar(100)
  fromStatus      String?        @map("from_status") @db.VarChar(50)
  toStatus        String?        @map("to_status") @db.VarChar(50)
  fromAssigneeId  String?        @map("from_assignee_id") @db.Uuid
  toAssigneeId    String?        @map("to_assignee_id") @db.Uuid
  note            String?
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  task            AdminQueueTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor           User           @relation("AdminQueueTaskEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("admin_queue_task_events")
}

model Shop {
  id                    String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  sellerProfileId       String                 @map("seller_profile_id") @db.Uuid
  name                  String                 @db.VarChar(255)
  slug                  String                 @unique @db.VarChar(255)
  logoUrl               String?                @map("logo_url") @db.VarChar(1024)
  contactInfo           String?                @map("contact_info")
  bankName              String?                @map("bank_name") @db.VarChar(255)
  accountNumber         String?                @map("account_number") @db.VarChar(255)
  accountHolderName     String?                @map("account_holder_name") @db.VarChar(255)
  bik                   String?                @db.VarChar(50)
  correspondentAccount  String?                @map("correspondent_account") @db.VarChar(255)
  paymentInstructions   String?                @map("payment_instructions")
  paymentMode           String?                @default("STATIC_QR") @map("payment_mode") @db.VarChar(50)
  paymentConfigStatus   String                 @default("PENDING_REVIEW") @map("payment_config_status") @db.VarChar(50)
  allowPrepaidQr        Boolean                @default(true) @map("allow_prepaid_qr")
  allowPayOnDeliverySellerQr Boolean           @default(false) @map("allow_pay_on_delivery_seller_qr")
  allowDepositPayment   Boolean                @default(false) @map("allow_deposit_payment")
  depositPercent        Int?                   @map("deposit_percent")
  depositRequiredAboveAmount Decimal?          @map("deposit_required_above_amount") @db.Decimal(10, 2)
  codMaxOrderAmount     Decimal?               @map("cod_max_order_amount") @db.Decimal(10, 2)
  yandexCardOnDeliveryStatus String            @default("NOT_CONFIGURED") @map("yandex_card_on_delivery_status") @db.VarChar(50)
  cashCourierCollectionStatus String           @default("NOT_AVAILABLE") @map("cash_courier_collection_status") @db.VarChar(50)
  recipientPhone        String?                @map("recipient_phone") @db.VarChar(50)
  sbpPhone              String?                @map("sbp_phone") @db.VarChar(50)
  staticQrImageUrl      String?                @map("static_qr_image_url") @db.VarChar(1000)
  staticQrStorageKey    String?                @map("static_qr_storage_key") @db.VarChar(1024)
  staticQrOriginalName  String?                @map("static_qr_original_name") @db.VarChar(255)
  staticQrMimeType      String?                @map("static_qr_mime_type") @db.VarChar(100)
  staticQrSize          Int?                   @map("static_qr_size")
  status                String                 @default("DRAFT") @db.VarChar(50)
  sellerProfile         SellerProfile          @relation("SellerProfileShops", fields: [sellerProfileId], references: [id], onDelete: Cascade)
  currentForProfiles    SellerProfile[]        @relation("CurrentShopSelection")
  products              Product[]
  aiGenerationTasks     AiGenerationTask[]
  aiGeneratedImages     AiGeneratedImage[]
  aiCredits             SellerAiCredit?
  aiUsageLogs           AiUsageLog[]
  aiTryOnTasks          AiTryOnTask[]
  aiTryOnUsageLogs      AiTryOnUsageLog[]
  orders                Order[]
  paymentReviewLogs     PaymentReviewLog[]
  supportCases          SupportCase[]
  deliverySettings      ShopDeliverySetting?
  deliveryOffers        DeliveryOffer[]
  deliveryShipments     DeliveryShipment[]
  deliveryEvents        DeliveryEvent[]
  productImportSessions ProductImportSession[]
  wbCredentials         ShopWbCredential?
  wbSyncRuns            WbSyncRun[]
  commissionSettings    ShopCommissionSetting[]
  sponsoredCampaigns    SponsoredCampaign[]
  sellerWallet          SellerWallet?
  billingLedgerEntries  BillingLedgerEntry[]
  sellerFeeLedgerEntries SellerFeeLedgerEntry[]
  sellerMonthlyInvoices SellerMonthlyInvoice[]
  returnRefundCases     ReturnRefundCase[]
  productReviews        ProductReview[]
  messageThreads        ShopMessageThread[]

  @@map("shops")
}

model Category {
  id             BigInt            @id
  name           String            @db.VarChar(255)
  slug           String?           @db.VarChar(255)
  parentId       BigInt?           @map("parent_id")
  sortOrder      Int               @default(0) @map("sort_order")
  isActive       Boolean           @default(true) @map("is_active")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamp(6)
  products       Product[]
  parent         Category?         @relation("CategoryTree", fields: [parentId], references: [id])
  children       Category[]        @relation("CategoryTree")
  sourceMappings CategoryMapping[]

  @@index([slug])
  @@map("categories")
}

model CategoryMapping {
  id                 String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  source             String   @db.VarChar(100)
  sourceCategoryName String   @map("source_category_name") @db.VarChar(255)
  sourceSubjectName  String?  @map("source_subject_name") @db.VarChar(255)
  targetCategoryId   BigInt   @map("target_category_id")
  confidence         Decimal? @db.Decimal(5, 4)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamp(6)
  targetCategory     Category @relation(fields: [targetCategoryId], references: [id])

  @@index([source, sourceCategoryName])
  @@index([targetCategoryId])
  @@map("category_mappings")
}

model Product {
  id                String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  shopId            String             @map("shop_id") @db.Uuid
  wbNmId            BigInt             @map("wb_nm_id")
  wbImtId           BigInt?            @map("wb_imt_id")
  wbNmUuid          String?            @map("wb_nm_uuid") @db.VarChar(255)
  brand             String?            @db.VarChar(255)
  wbTitle           String             @map("wb_title") @db.VarChar(500)
  wbDescription     String?            @map("wb_description")
  categoryName      String?            @map("category_name") @db.VarChar(255)
  sourceCategoryName   String?         @map("source_category_name") @db.VarChar(255)
  sourceCategorySource String?         @map("source_category_source") @db.VarChar(100)
  externalSource    String?            @map("external_source") @db.VarChar(100)
  externalProductId String?            @map("external_product_id") @db.VarChar(255)
  sellerSku         String?            @map("seller_sku") @db.VarChar(255)
  gender            String?            @db.VarChar(255)
  composition       String?
  color             String?            @db.VarChar(255)
  wbVendorCode      String?            @map("wb_vendor_code") @db.VarChar(255)
  wbVideoUrl        String?            @map("wb_video_url")
  wbCreatedAt       DateTime?          @map("wb_created_at") @db.Timestamp(6)
  wbUpdatedAt       DateTime?          @map("wb_updated_at") @db.Timestamp(6)
  wbNeedKiz         Boolean?           @default(false) @map("wb_need_kiz")
  subjectId         BigInt?            @map("subject_id")
  categoryId        BigInt?            @map("category_id")
  wholesaleEnabled  Boolean?           @default(false) @map("wholesale_enabled")
  wholesaleQuantum  Int?               @map("wholesale_quantum")
  length            Int?
  width             Int?
  height            Int?
  weightBrutto      Int?               @map("weight_brutto")
  dimensionsValid   Boolean?           @default(false) @map("dimensions_valid")
  localTitle        String?            @map("local_title") @db.VarChar(500)
  localDescription  String?            @map("local_description")
  seoSlug           String?            @map("seo_slug") @db.VarChar(500)
  visibility        String?            @default("ACTIVE") @db.VarChar(50)
  catalogStatus     String             @default("PUBLISHED") @map("catalog_status") @db.VarChar(50)
  publishedAt       DateTime?          @map("published_at") @db.Timestamptz(6)
  unpublishedAt     DateTime?          @map("unpublished_at") @db.Timestamptz(6)
  archivedAt        DateTime?          @map("archived_at") @db.Timestamptz(6)
  source            String             @default("MANUAL") @db.VarChar(100)
  sourceProductUrl  String?            @map("source_product_url") @db.VarChar(1000)
  reviewWarningsJson Json?             @map("review_warnings_json")
  localTags         Json?              @map("local_tags")
  averageRating     Decimal?           @default(0) @map("average_rating") @db.Decimal(3, 2)
  feedbackCount     Int?               @default(0) @map("feedback_count")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamp(6)
  shop              Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category          Category?          @relation(fields: [categoryId], references: [id])
  images            ProductImage[]
  variants          ProductVariant[]
  orderItems        OrderItem[]
  aiGenerationTasks AiGenerationTask[]
  aiGeneratedImages AiGeneratedImage[]
  aiTryOnTasks      AiTryOnTask[]
  aiTryOnUsageLogs  AiTryOnUsageLog[]
  productReviews    ProductReview[]
  messageThreads    ShopMessageThread[]
  sponsoredCampaignTargets SponsoredCampaignProduct[]
  aiTryOnEnabled    Boolean            @default(false) @map("ai_try_on_enabled")

  @@unique([shopId, wbNmId])
  @@unique([shopId, sellerSku])
  @@map("products")
}

model SponsoredCampaign {
  id            String                     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  shopId        String                     @map("shop_id") @db.Uuid
  name          String                     @db.VarChar(255)
  description   String?                    @db.VarChar(1000)
  status        String                     @default("draft") @db.VarChar(50)
  scenarioTypes String[]                   @default([]) @map("scenario_types")
  startAt       DateTime?                  @map("start_at") @db.Timestamptz(6)
  endAt         DateTime?                  @map("end_at") @db.Timestamptz(6)
  budgetLimit   Decimal?                   @map("budget_limit") @db.Decimal(12, 2)
  billingMode   String                     @default("none") @map("billing_mode") @db.VarChar(50)
  maxBoost      Decimal                    @default(0) @map("max_boost") @db.Decimal(6, 2)
  createdAt     DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  shop          Shop                       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  targets       SponsoredCampaignProduct[]
  billingLedgerEntries BillingLedgerEntry[]

  @@index([shopId, status, updatedAt])
  @@index([shopId, createdAt])
  @@map("sponsored_campaigns")
}

model SponsoredCampaignProduct {
  id         String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  campaignId String            @map("campaign_id") @db.Uuid
  productId  String            @map("product_id") @db.Uuid
  boost      Decimal           @default(0) @db.Decimal(6, 2)
  status     String            @default("active") @db.VarChar(50)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  campaign   SponsoredCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product    Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([campaignId, productId])
  @@index([campaignId, status, updatedAt])
  @@index([productId, status])
  @@map("sponsored_campaign_products")
}

model SellerWallet {
  id              String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  shopId          String             @unique @map("shop_id") @db.Uuid
  balance         Decimal            @default(0) @db.Decimal(14, 2)
  reservedBalance Decimal            @default(0) @map("reserved_balance") @db.Decimal(14, 2)
  currency        String             @default("RUB") @db.VarChar(10)
  status          String             @default("active") @db.VarChar(50)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  shop            Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  ledgerEntries   BillingLedgerEntry[]

  @@index([status, createdAt])
  @@map("seller_wallets")
}

model BillingLedgerEntry {
  id             String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  walletId       String             @map("wallet_id") @db.Uuid
  shopId         String             @map("shop_id") @db.Uuid
  campaignId     String?            @map("campaign_id") @db.Uuid
  type           String             @db.VarChar(50)
  amount         Decimal            @db.Decimal(14, 2)
  currency       String             @default("RUB") @db.VarChar(10)
  balanceBefore  Decimal            @map("balance_before") @db.Decimal(14, 2)
