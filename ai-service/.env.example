# AI service local or production template.
# Use mock-safe defaults unless a production env file overrides them.

ENVIRONMENT=production
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000

# Internal auth between backend and ai-service
INTERNAL_API_TOKEN=change-me-internal-token
AI_SERVICE_INTERNAL_TOKEN=change-me-internal-token

# Providers
AI_IMAGE_PROVIDER=mock
AI_TRY_ON_ENABLED=false
AI_TRY_ON_PROVIDER=demo
OPENAI_API_KEY=

# OpenAI image settings
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1536
# For the most realistic try-on use "high" (sharper, more lifelike) instead of
# "medium"; raises cost per image. Options: low | medium | high | auto.
OPENAI_IMAGE_QUALITY=medium
# Use "png" (or "webp") for lossless output without JPEG compression artifacts.
OPENAI_IMAGE_OUTPUT_FORMAT=jpeg
# gpt-image-1 only. "high" keeps the input face + garment details faithful
# (strongly recommended for try-on). "low" is cheaper but less accurate.
OPENAI_IMAGE_INPUT_FIDELITY=high
OPENAI_IMAGE_TIMEOUT_SECONDS=120
OPENAI_IMAGE_MAX_RETRIES=1
RUN_OPENAI_SMOKE=false

# AI Try-On production default: disabled, demo provider
AI_TRY_ON_OPENAI_MODEL=gpt-image-1
AI_TRY_ON_PROVIDER_TIMEOUT_SECONDS=120
AI_TRY_ON_OUTPUT_SIZE=1024x1536

# Input limits
MAX_INPUT_IMAGE_SIZE_MB=15
INPUT_IMAGE_DOWNLOAD_TIMEOUT_SECONDS=20

# WB-like visual product embeddings
VISUAL_EMBEDDING_PROVIDER=mock
VISUAL_EMBEDDING_MODEL=ViT-B-32
VISUAL_EMBEDDING_PRETRAINED=laion2b_s34b_b79k
VISUAL_EMBEDDING_DIMENSIONS=512
VISUAL_EMBEDDING_MAX_BYTES=8388608
VISUAL_EMBEDDING_DOWNLOAD_TIMEOUT_SECONDS=15
VISUAL_EMBEDDING_ALLOWED_HOSTS=backend-nest,minio

# Storage
STORAGE_DRIVER=s3
AI_OUTPUT_DIR=./storage/generated
PUBLIC_BASE_URL=https://storage.yourdomain.ru
STORAGE_PUBLIC_BASE_URL=https://storage.yourdomain.ru
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://storage.yourdomain.ru
S3_REGION=us-east-1
S3_BUCKET=strawberry-ai-assets
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-minio-password
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=change-me-minio-password
