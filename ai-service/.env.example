# development profile; keep test profile in .env.test.example and production values in the deploy env
ENVIRONMENT=development
AI_SERVICE_INTERNAL_TOKEN=local-internal-token
AI_IMAGE_PROVIDER=mock
RUN_OPENAI_SMOKE=false
OPENAI_API_KEY=
# Opt-in real OpenAI verification requires all of:
# AI_IMAGE_PROVIDER=openai
# RUN_OPENAI_SMOKE=true
# OPENAI_API_KEY=<local-only-secret>
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_OUTPUT_FORMAT=jpeg
OPENAI_IMAGE_TIMEOUT_SECONDS=120
OPENAI_IMAGE_MAX_RETRIES=1

# local dev defaults; keep mock-safe runtime by default
STORAGE_DRIVER=mock
AI_OUTPUT_DIR=./storage/generated
PUBLIC_BASE_URL=http://localhost:8000
MAX_INPUT_IMAGE_SIZE_MB=10
INPUT_IMAGE_DOWNLOAD_TIMEOUT_SECONDS=15

# keep S3 blank in local dev unless you explicitly run MinIO/S3
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
