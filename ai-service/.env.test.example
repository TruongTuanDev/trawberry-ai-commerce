# pytest and local mock-safe verification profile
ENVIRONMENT=test
AI_SERVICE_INTERNAL_TOKEN=test-internal-token

# force test isolation away from real external providers
AI_IMAGE_PROVIDER=mock
OPENAI_API_KEY=
RUN_OPENAI_SMOKE=false

# metadata-only storage for tests
STORAGE_DRIVER=mock
STORAGE_LOCAL_ROOT=./generated-test
STORAGE_PUBLIC_BASE_URL=http://testserver/generated

# keep all real object storage settings blank in test mode
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
